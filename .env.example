# === Telegram ===
# @BotFather bergan token
TELEGRAM_BOT_TOKEN=
# Haqiqiy kanal ID (-100... ko'rinishida)
CHANNEL_ID=
# Kanal username, masalan @it_dunyosi (suv belgisi va post oxiri uchun)
CHANNEL_USERNAME=
# Yopiq test kanal ID (bot u yerda ham admin)
TEST_CHANNEL_ID=
# Kanal izohlari guruhi ID (ixtiyoriy, lekin tavsiya)
DISCUSSION_GROUP_ID=
# Test guruh ID (moderatsiya va savol-javobni sinash uchun, ixtiyoriy)
TEST_GROUP_ID=
# Admin Telegram ID lari, vergul bilan: 123456789,987654321
ADMIN_IDS=
TZ=Asia/Tashkent

# === MongoDB (Atlas yoki o'z serveringiz) ===
# mongodb+srv://foydalanuvchi:parol@cluster.xxxxx.mongodb.net/
MONGODB_URI=
# Bot faqat shu bazadan foydalanadi (URI dagi boshqa bazalarga tegmaydi)
MONGODB_DB=it_dunyosi_bot

# Nashr rejimi: auto | semi_auto | manual
PUBLISH_MODE=semi_auto
# true bo'lsa faqat TEST_CHANNEL_ID ga yuboradi
DRY_RUN=true

# === 1-kalit: asosiy matn modeli ("Yozuvchi") ===
# anthropic | openai | gemini | deepseek | openai_compatible
LLM_MAIN_PROVIDER=
# masalan: deepseek-flash, deepseek-v4-pro (aniq nomlarni scripts/check_ai.py koʻrsatadi)
LLM_MAIN_MODEL=
LLM_MAIN_API_KEY=
# faqat openai_compatible uchun; deepseek uchun avtomatik https://api.deepseek.com
LLM_MAIN_BASE_URL=

# === 2-kalit: rasm generatsiya ("Dizayner") ===
# openai | gemini | stability | replicate | fal | none
IMAGE_PROVIDER=
IMAGE_MODEL=
IMAGE_API_KEY=
# 1:1 -> 1024x1024, 16:9 -> 1536x1024 (provayderga moslashtiriladi)
IMAGE_SIZE=1024x1024

# === 3-kalit: OpenAI ("Bosh muharrir / tahlilchi") ===
OPENAI_API_KEY=
OPENAI_EDITOR_MODEL=gpt-6-sol
OPENAI_FAST_MODEL=gpt-6-luna

# === Rasm qidirish (bepul, muallif koʻrsatilishi shart emas): https://www.pexels.com/api/ ===
PEXELS_API_KEY=

# === Ixtiyoriy manba kalitlari (boʻsh qolsa ham ishlaydi) ===
NVD_API_KEY=
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=

# === Tizim ===
DAILY_BUDGET_USD=3
LOG_LEVEL=INFO
# Obunachi ID larini xeshlash uchun tuz (bo'sh bo'lsa birinchi ishga tushishda yaratiladi)
HASH_SALT=
# Model narxlarini almashtirish (ixtiyoriy, JSON): {"gpt-6-sol": {"in": 2.0, "out": 10.0, "cached": 0.2}}
MODEL_PRICES_JSON=

# Mini ilova (panel). WEBAPP_URL — ommaviy HTTPS manzil (VPS da: https://IP-manzil.sslip.io). Boʻsh boʻlsa panel tugmasi chiqmaydi.
WEBAPP_URL=
WEB_PORT=8080

# Telethon (koʻrishlar va kanal statistikasi): my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# TG_SESSION ni scripts/telethon_login.py oʻzi yozadi
TG_SESSION=
